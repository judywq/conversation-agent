# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython

# Superuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=MyPass123

# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=conversation_agent

# OpenAI web search
# ------------------------------------------------------------------------------
WEB_SEARCH_ENABLED=True
WEB_SEARCH_MODEL=gpt-5
WEB_SEARCH_TIMEOUT_SEC=30

USER_MEMORY_EXTRACTION_ENABLED=True

# Conversation
# ------------------------------------------------------------------------------
CONVERSATION_MAX_TURNS=10
# Short-term memory window: how many recent turns are put into LLM prompts.
CONVERSATION_SHORT_TERM_TURNS=3
# Set to True to give agents the whole transcript instead of the window above.
CONVERSATION_FULL_CONTEXT=False
# Experiment runs only: an LLM answers on the learner's behalf instead of the browser.
# MUST stay False anywhere real participants use the system.
SIMULATED_STUDENT_ENABLED=False
# Skip agent text-to-speech while simulating (only consulted when simulating).
SIMULATED_STUDENT_SKIP_TTS=True
