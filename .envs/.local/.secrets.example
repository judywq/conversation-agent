# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

# Email
# ------------------------------------------------------------------------------
# Set to True to use Anymail with Mailjet, False to use mailpit
USE_THIRD_PARTY_EMAIL_SERVICE=False
DJANGO_DEFAULT_FROM_EMAIL="Your Name <your.name@example.com>"

# Mailjet
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=flower_user
CELERY_FLOWER_PASSWORD=flower_password


LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your-api-key"
LANGSMITH_PROJECT="conversation-agent-dev"

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=

# OpenAI web search
# ------------------------------------------------------------------------------
WEB_SEARCH_ENABLED=True
WEB_SEARCH_MODEL=gpt-5
WEB_SEARCH_TIMEOUT_SEC=30

# Embeddings / vector retrieval
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_RECALL_ENABLED=True

# Web search provider: "openai" (default) or "tavily"
WEB_SEARCH_PROVIDER=tavily
TAVILY_API=YOUR_TAVILY_API_KEY

# TTS provider: "openai" (default) or "fish"
TTS_PROVIDER=openai
FISH_API_KEY=
FISH_TTS_MODEL=s2-pro
FISH_TTS_FORMAT=mp3
FISH_TTS_REFERENCE_ID=
FISH_TTS_CONNECT_TIMEOUT_SEC=15
FISH_TTS_TIMEOUT_SEC=90

