# General
# ------------------------------------------------------------------------------
DJANGO_DOMAIN_NAME=YOUR_DOMAIN_NAME

DJANGO_SECRET_KEY=YOUR_SECRET_KEY_HERE
DJANGO_ALLOWED_HOSTS=YOUR_DOMAIN_NAME,localhost

# Superuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password

# Email
# ------------------------------------------------------------------------------
DJANGO_DEFAULT_FROM_EMAIL="Your Name <your.name@example.com>"

MAILJET_API_KEY=YOUR_MAILJET_API_KEY
MAILJET_SECRET_KEY=YOUR_MAILJET_SECRET_KEY

# Sentry
# ------------------------------------------------------------------------------
SENTRY_DSN=

# Flower
CELERY_FLOWER_USER=flower_user
CELERY_FLOWER_PASSWORD=flower_password

# Vue
VITE_API_BASE_URL=http://YOUR_DOMAIN_NAME/api

# Langsmith
# Global tracing off; staff/superuser sessions opt in via tracing_context in code.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="your-api-key"
LANGSMITH_PROJECT="conversation-agent-dev"
LANGCHAIN_TRACING_V2=false

# LLM API Keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Embeddings / vector retrieval
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_RECALL_ENABLED=True

# Web search provider: "openai" (default) or "tavily"
WEB_SEARCH_PROVIDER=tavily
TAVILY_API=YOUR_TAVILY_API_KEY

WEB_SEARCH_PROVIDER=tavily
TAVILY_API=YOUR_TAVILY_API_KEY

# TTS provider: "openai" (default), "fish", or "elevenlabs"

TTS_PROVIDER=

#Fish
FISH_API_KEY=
FISH_TTS_MODEL=s2-pro
FISH_TTS_FORMAT=mp3
FISH_TTS_REFERENCE_ID=
FISH_TTS_CONNECT_TIMEOUT_SEC=15
FISH_TTS_TIMEOUT_SEC=90

#ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_DEFAULT_VOICE_ID=
ELEVENLABS_TTS_CONNECT_TIMEOUT_SEC=15
ELEVENLABS_TTS_TIMEOUT_SEC=90

# Miniflux (http://miniflux:8080 inside Docker; admin UI on host port 8081 if exposed)
# Pass this file to compose for miniflux service credentials:
# docker compose --env-file .envs/.production/.secrets -f docker-compose.production.yml up -d
# ------------------------------------------------------------------------------
MINIFLUX_BASE_URL=http://miniflux:8080
MINIFLUX_API_TOKEN=
MINIFLUX_TIMEOUT_SEC=15.0
NEWS_SYNC_BATCH_SIZE=100
NEWS_CLASSIFICATION_BATCH_SIZE=25
